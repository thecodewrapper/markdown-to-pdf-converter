{
  "name": "markdown-to-pdf-converter",
  "version": "1.0.0",
  "description": "A focused desktop Markdown editor and PDF exporter.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "electron-builder --dir"
  },
  "dependencies": {
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.thecodewrapper.markdowntopdf",
    "productName": "Markdown to PDF",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
